<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-VARIANT OVERRIDE of src/main/res/xml/shortcuts.xml.

    Why this file exists
    ====================
    android:targetPackage in a static shortcut is read as a *plain string* by
    Intent.parseIntent() (frameworks/base core/java/android/content/Intent.java):

        String packageName = sa.getString(R.styleable.Intent_targetPackage);
        String className   = sa.getString(R.styleable.Intent_targetClass);
        if (packageName != null && className != null) {
            intent.setComponent(new ComponentName(packageName, className));
        }

    Two consequences we have to live with:

      1. ${applicationId} manifest placeholders are NOT substituted outside
         AndroidManifest.xml, and @string/... cannot be used here either, because
         ShortcutParser resolves the styled attribute against the *system* Resources
         (ShortcutService.mContext.getResources()), not the app's. The package must
         therefore be spelled out literally.
      2. If either attribute is missing the component is never set and the intent
         degrades to a bare implicit intent — which, with both the release and the
         debug build installed, would raise a disambiguation dialog instead of
         silently doing nothing. So we keep both attributes and only fix the package.

    The debug build type applies applicationIdSuffix = ".bydhudtest", so the single
    differing attribute in this copy is android:targetPackage.

    MAINTENANCE: whenever `applicationId` or the debug `applicationIdSuffix` in
    app/build.gradle.kts changes, update the seven android:targetPackage values in
    THIS file to match the debug applicationId. Keeping it wrong makes every
    launcher long-press shortcut a silent no-op (ActivityNotFoundException:
    "Shortcut could not be started").

    Debug applicationId: com.andrerinas.headunitrevived.bydhudtest
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="connect_last"
        android:enabled="true"
        android:icon="@drawable/ic_stat_aa"
        android:shortcutShortLabel="@string/shortcut_connect_title"
        android:shortcutLongLabel="@string/shortcut_connect_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_CONNECT"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="self_mode"
        android:enabled="true"
        android:icon="@drawable/ic_stat_aa"
        android:shortcutShortLabel="@string/shortcut_selfmode_title"
        android:shortcutLongLabel="@string/shortcut_selfmode_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_START_SELF_MODE"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="disconnect"
        android:enabled="true"
        android:icon="@drawable/ic_exit_to_app_white_24dp"
        android:shortcutShortLabel="@string/shortcut_disconnect_title"
        android:shortcutLongLabel="@string/shortcut_disconnect_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_DISCONNECT"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="exit_app"
        android:enabled="true"
        android:icon="@drawable/ic_exit_to_app_white_24dp"
        android:shortcutShortLabel="@string/shortcut_exit_title"
        android:shortcutLongLabel="@string/shortcut_exit_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_STOP_SERVICE"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity" />
    </shortcut>

    <shortcut
        android:shortcutId="night_mode_day"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_day"
        android:shortcutShortLabel="@string/shortcut_night_mode_day_title"
        android:shortcutLongLabel="@string/shortcut_night_mode_day_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_SET_NIGHT_MODE"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity">
            <extra android:name="state" android:value="day" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="night_mode_night"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:shortcutShortLabel="@string/shortcut_night_mode_night_title"
        android:shortcutLongLabel="@string/shortcut_night_mode_night_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_SET_NIGHT_MODE"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity">
            <extra android:name="state" android:value="night" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="night_mode_auto"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:shortcutShortLabel="@string/shortcut_night_mode_auto_title"
        android:shortcutLongLabel="@string/shortcut_night_mode_auto_desc">
        <intent
            android:action="com.andrerinas.openheadunit.ACTION_SET_NIGHT_MODE"
            android:targetPackage="com.andrerinas.headunitrevived.bydhudtest"
            android:targetClass="com.andrerinas.openheadunit.main.AutomationActivity">
            <extra android:name="state" android:value="auto" />
        </intent>
    </shortcut>
</shortcuts>
